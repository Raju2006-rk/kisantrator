# KisanTractor environment variables
#
# Required for production. Copy this file to .env.local for local development.
#
# 1. Create a project at https://supabase.com
# 2. Run supabase/app_state.sql in the SQL editor (application data)
# 3. Enable Phone Auth and configure an SMS provider in Authentication > Providers
# 4. Copy the project URL and keys below
#
# The anon key is safe for the browser. The service role key must only ever be
# used on the server (it bypasses row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the login and trusted-device cookies. Required in production; generate
# a long random value (for example: openssl rand -base64 48).
SESSION_SECRET=

# Development-only fallback OTP. When Supabase Auth is not configured, the app
# can generate a random OTP and return it in the API response instead of sending
# an SMS. Enabled by default outside production. Never enable in production.
AUTH_DEV_OTP=

# Escape hatch for local production builds without Supabase. When unset, a
# production build refuses to start without Supabase credentials.
ALLOW_LOCAL_DB=false
